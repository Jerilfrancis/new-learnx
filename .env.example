# ─────────────────────────────────────────────
# LearnX — Environment Variables Example
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:3000

# ─────────────────────────────────────────────
# DATABASE — MongoDB Atlas
# ─────────────────────────────────────────────
# MONGODB_URI: MongoDB Atlas connection string
# Use your MongoDB Atlas connection string with credentials supplied locally.
# Note: Use Database User credentials (from Atlas Security > Database Access), NOT your Atlas account login
MONGODB_URI=

# LOCAL_MONGODB_URI: Local MongoDB connection (for development)
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/code_infinite

# USE_LOCAL_MONGODB: Set to 'true' to use local MongoDB instead of Atlas
# Default: false (Atlas is primary database)
USE_LOCAL_MONGODB=false

# MONGODB_DNS_SERVERS: Custom DNS servers for SRV record resolution
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# ─────────────────────────────────────────────
# AUTHENTICATION — JWT
# ─────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=

# ─────────────────────────────────────────────
# EMAIL — Resend (https://resend.com)
# Sign up → API Keys → Create API Key → Full Access
# ─────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Gmail notifications — use a Gmail App Password, not your regular password
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=

# ─────────────────────────────────────────────
# CLOUD STORAGE — Cloudinary (https://cloudinary.com)
# Sign in → Dashboard → Product Environment Credentials
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────
# UPLOAD SECURITY — ClamAV
# ─────────────────────────────────────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ─────────────────────────────────────────────
# GOOGLE OAUTH (https://console.cloud.google.com)
# Create OAuth 2.0 Client ID → Web Application
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ─────────────────────────────────────────────
# GITHUB OAUTH (https://github.com/settings/apps)
# New OAuth App → Authorization callback URL: http://localhost:3000/api/auth/github/callback
# ─────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# ─────────────────────────────────────────────
# AI — GROQ API (https://console.groq.com)
# Generates MCQs & Quizzes for Educators
# ─────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─────────────────────────────────────────────
# AI — Google Gemini (Optional)
# ─────────────────────────────────────────────
GEMINI_API_KEY=

# ─────────────────────────────────────────────
# LIVE CLASSES — LiveKit (Optional)
# ─────────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─────────────────────────────────────────────
# INTEGRATIONS — GitHub and push notifications (Optional)
# ─────────────────────────────────────────────
GITHUB_TOKEN=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
